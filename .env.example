# Existing Gemini integration
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OpenRouter multi-agent analysis
# Keep this secret server-side only. Never expose it as VITE_OPENROUTER_API_KEY.
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_MODEL="openai/gpt-chat-latest"
# OPENROUTER_MODEL_TECHNICAL="openai/gpt-chat-latest"
# OPENROUTER_MODEL_SMC="openai/gpt-chat-latest"
# OPENROUTER_MODEL_WYCKOFF_GANN="openai/gpt-chat-latest"
# OPENROUTER_MODEL_DIVERGENCE="openai/gpt-chat-latest"

# Public application URL used only as the optional OpenRouter HTTP-Referer.
APP_URL="https://seu-projeto.vercel.app"

# Optional persistent Paper Trading storage via Upstash Redis REST.
# If these are absent, the app keeps the existing in-memory fallback.
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"
UPSTASH_REDIS_REST_KEY="bottrade:paper:state"
